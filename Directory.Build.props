<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1848/CA1873: LoggerMessage delegates are used on hot paths only; CA1716: "Domain" namespace words; CA1711/CA1515: app types -->
    <NoWarn>$(NoWarn);CA1000;CA1848;CA1873;CA1716;CA1711;CA1515;CA2007;CA1062;CA1819;CA1307;CA1309;CA1305;CA1304;CA1311;CA1031;CA1822;CA1852;CA1056;CA1054;CA1055;CA2234;CA1002;CA1034;CA1724;CA1812;CA2227</NoWarn>
    <Authors>NeuralBridge contributors</Authors>
    <Product>NeuralBridge</Product>
  </PropertyGroup>
</Project>
