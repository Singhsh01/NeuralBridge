@* Shared frame for sign-in pages: a centred card with title, optional status or error, and an aside. *@
<div class="page-form auth-page">
    <section class="card form-card" aria-labelledby="auth-title">
        <h1 id="auth-title" class="form-card-title">@Title</h1>
        @if (Subtitle is not null)
        {
            <p class="form-card-sub">@Subtitle</p>
        }
        @if (Error is not null)
        {
            <p class="banner banner-error" role="alert" data-testid="auth-error"><Icon Name="circle-alert" /><span>@Error</span></p>
        }
        @if (Status is not null)
        {
            <p class="banner banner-ok" role="status" data-testid="auth-status"><Icon Name="circle-check" /><span>@Status</span></p>
        }
        @ChildContent
    </section>
    @if (Aside is not null)
    {
        <p class="page-aside">@Aside</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Kept for callers; the redesigned card no longer shows an icon.</summary>
    [Parameter] public string IconName { get; set; } = "key-round";

    [Parameter] public string? IconClass { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Status { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Aside { get; set; }
}
