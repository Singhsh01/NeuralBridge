@page "/account/forgot-password"
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using NeuralBridge.Application.Abstractions
@using NeuralBridge.Infrastructure.Identity
@using NeuralBridge.Web.Auth
@inject UserManager<ApplicationUser> UserManager
@inject IAccountEmailSender Email
@inject AuthProviderStatus Providers
@inject IAppRateLimiter RateLimiter
@inject NavigationManager Navigation

<PageTitle>Reset password · NeuralBridge</PageTitle>

<AccountShell Title="Reset your password" IconName="mail" Error="@_error"
              Subtitle="@(Providers.PasswordResetAvailable ? "Enter your account's email address and we'll send a link to choose a new password." : null)"
              Status="@(Sent ? "If an account exists for that address, a reset link is on its way. It works for 2 hours." : null)">
    <ChildContent>
        @if (!Providers.PasswordResetAvailable)
        {
            <p data-testid="reset-unavailable">Password reset by email isn't available on this server. Ask the person who runs this NeuralBridge to reset it for you, or sign in with Google if your account uses it.</p>
            <a class="btn btn-quiet" href="/account/login">Back to log in</a>
        }
        else if (!Sent)
        {
            <EditForm Model="Input" method="post" OnValidSubmit="SendAsync" FormName="forgot" class="auth-form" novalidate>
                <DataAnnotationsValidator />
                <div class="field">
                    <label class="field-label with-icon" for="forgot-email"><Icon Name="mail" /> Email</label>
                    <InputText id="forgot-email" class="input" type="email" autocomplete="email" @bind-Value="Input.Email" data-testid="forgot-email" />
                    <ValidationMessage For="() => Input.Email" class="form-error" />
                </div>
                <button type="submit" class="btn btn-primary btn-lg btn-block" data-testid="forgot-submit">
                    <Icon Name="mail" /><span class="btn-label">Send reset link</span>
                </button>
            </EditForm>
        }
        else
        {
            <a class="btn btn-quiet" href="/account/login"><Icon Name="log-in" /><span class="btn-label">Back to log in</span></a>
        }
    </ChildContent>
</AccountShell>

@code {
    private string? _error;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Name matches the property used in the @bind expressions below (field names are "Input.Email" etc.).
    [SupplyParameterFromForm(FormName = "forgot", Name = "Input")] private ForgotInput? InputPosted { get; set; }

    private ForgotInput Input => InputPosted ??= new();

    [SupplyParameterFromQuery(Name = "sent")] private string? SentFlag { get; set; }

    private bool Sent => SentFlag == "1";

    private async Task SendAsync()
    {
        if (!Providers.PasswordResetAvailable)
        {
            return;
        }

        if (!RateLimiter.TryAcquire(RateLimitPolicy.Authentication, ClientContext.FromHttpContext(HttpContext)))
        {
            _error = ErrorMessages.For(SessionError.RateLimited);
            return;
        }

        var user = await UserManager.FindByEmailAsync(Input.Email.Trim());
        if (user is not null && await UserManager.HasPasswordAsync(user))
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
            var link = Navigation.ToAbsoluteUri($"account/reset-password?email={Uri.EscapeDataString(user.Email!)}&code={code}").AbsoluteUri;
            await Email.SendPasswordResetAsync(user.Email!, UserClaims.FallbackName(user.DisplayName, user.Email), link);
        }

        // Same response whether or not the account exists (no account enumeration).
        Navigation.NavigateTo("/account/forgot-password?sent=1");
    }

    private sealed class ForgotInput
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
