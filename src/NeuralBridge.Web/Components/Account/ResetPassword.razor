@page "/account/reset-password"
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using NeuralBridge.Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Choose a new password · NeuralBridge</PageTitle>

<AccountShell Title="Choose a new password" IconName="key-round" Error="@_error">
    @if (string.IsNullOrEmpty(Code) || string.IsNullOrEmpty(Email))
    {
        <p>This reset link is incomplete. Request a new one.</p>
        <a class="btn btn-primary" href="/account/forgot-password">Request a new link</a>
    }
    else
    {
        <EditForm Model="Input" method="post" OnValidSubmit="ResetAsync" FormName="reset" class="auth-form" novalidate>
            <DataAnnotationsValidator />
            <p class="hint">For @Email</p>
            <div class="field">
                <label class="field-label" for="reset-password">New password</label>
                <InputText id="reset-password" class="input" type="password" autocomplete="new-password" @bind-Value="Input.Password" data-testid="reset-password" />
                <ValidationMessage For="() => Input.Password" class="form-error" />
            </div>
            <div class="field">
                <label class="field-label" for="reset-confirm">Repeat new password</label>
                <InputText id="reset-confirm" class="input" type="password" autocomplete="new-password" @bind-Value="Input.ConfirmPassword" data-testid="reset-confirm" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="form-error" />
            </div>
            <button type="submit" class="btn btn-primary btn-lg btn-block" data-testid="reset-submit">
                <Icon Name="key-round" /><span class="btn-label">Save new password</span>
            </button>
        </EditForm>
    }
</AccountShell>

@code {
    private string? _error;

    // Name matches the property used in the @bind expressions below (field names are "Input.Email" etc.).
    [SupplyParameterFromForm(FormName = "reset", Name = "Input")] private ResetInput? InputPosted { get; set; }

    private ResetInput Input => InputPosted ??= new();

    [SupplyParameterFromQuery] private string? Code { get; set; }

    [SupplyParameterFromQuery] private string? Email { get; set; }

    private async Task ResetAsync()
    {
        var user = await UserManager.FindByEmailAsync(Email!);
        string token;
        try
        {
            token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code!));
        }
        catch (FormatException)
        {
            _error = "This reset link is invalid or has expired. Request a new one.";
            return;
        }

        if (user is null)
        {
            _error = "This reset link is invalid or has expired. Request a new one.";
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, token, Input.Password);
        if (!result.Succeeded)
        {
            _error = result.Errors.Any(e => e.Code == "InvalidToken")
                ? "This reset link is invalid or has expired. Request a new one."
                : string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        // ResetPasswordAsync rotates the security stamp: other signed-in devices are signed out.
        await UserManager.ResetAccessFailedCountAsync(user);
        await UserManager.SetLockoutEndDateAsync(user, null);
        Navigation.NavigateTo("/account/login?status=reset");
    }

    private sealed class ResetInput
    {
        [Required(ErrorMessage = "Choose a new password.")]
        [StringLength(128)]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "The passwords don't match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
