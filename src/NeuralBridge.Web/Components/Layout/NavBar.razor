@using NeuralBridge.Web.Auth
@inject AuthProviderStatus Providers
@inject NavigationManager Navigation

<header class="topbar">
    <a class="topbar-brand" href="/" aria-label="NeuralBridge home"><Logo /></a>

    <nav class="topbar-nav" aria-label="Main">
        <NavLink class="nav-link" href="/join">Join a session</NavLink>
        <NavLink class="nav-link" href="/help">Help</NavLink>
        <NavLink class="nav-link" href="/security">Security</NavLink>
    </nav>

    <div class="topbar-actions">
        <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch colour theme" data-tip="Switch light / dark theme">
            <Icon Name="sun" Class="icon-sun" /><Icon Name="moon" Class="icon-moon" />
        </button>

        <AuthorizeView>
            <Authorized>
                <AccountMenu User="context.User" />
            </Authorized>
            <NotAuthorized>
                @if (Providers.AccountsAvailable)
                {
                    <div class="auth-actions" data-testid="signed-out-actions">
                        <a class="btn btn-quiet btn-sm" href="@($"/account/login?returnUrl={Uri.EscapeDataString(ReturnPath)}")" data-testid="nav-login">Log in</a>
                        @if (Providers.LocalAccountsAvailable)
                        {
                            <a class="btn btn-secondary btn-sm" href="/account/register" data-testid="nav-register">Create account</a>
                        }
                    </div>
                }
            </NotAuthorized>
        </AuthorizeView>

        @* Small screens: the navigation and sign-in links in one menu. *@
        <details class="mobile-menu" data-menu>
            <summary class="icon-btn" aria-label="Open menu"><Icon Name="menu" /></summary>
            <div class="menu" role="menu">
                <a role="menuitem" href="/"><Icon Name="plus" /> Create a session</a>
                <a role="menuitem" href="/join"><Icon Name="log-in" /> Join a session</a>
                <a role="menuitem" href="/help"><Icon Name="circle-help" /> Help</a>
                <a role="menuitem" href="/security"><Icon Name="shield-check" /> Security</a>
                <AuthorizeView>
                    <NotAuthorized>
                        @if (Providers.AccountsAvailable)
                        {
                            <hr />
                            <a role="menuitem" href="@($"/account/login?returnUrl={Uri.EscapeDataString(ReturnPath)}")"><Icon Name="key-round" /> Log in</a>
                            @if (Providers.LocalAccountsAvailable)
                            {
                                <a role="menuitem" href="/account/register"><Icon Name="user-plus" /> Create account</a>
                            }
                        }
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </details>
    </div>
</header>

@code {
    /// <summary>Return to the current page after signing in (never to account pages themselves).</summary>
    private string ReturnPath
    {
        get
        {
            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0];
            return path.StartsWith("/account", StringComparison.OrdinalIgnoreCase) ? "/" : path;
        }
    }
}
