@page "/"
@using NeuralBridge.Web.Auth
@inject AuthProviderStatus Providers

<PageTitle>NeuralBridge: move text between your devices</PageTitle>

<div class="landing">
    <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
            <h1 id="hero-title" class="hero-title">Move text between your devices in seconds.</h1>
            <p class="hero-lede">
                Open a temporary session on one screen and join it from another. Whatever you type or paste
                appears on both, instantly. When the session ends, the text is deleted.
            </p>
            <div class="hero-actions">
                <a class="btn btn-primary btn-lg" href="#create" data-tab-link="create" data-testid="hero-create"><Icon Name="plus" /><span class="btn-label">Create a session</span></a>
                <a class="btn btn-secondary btn-lg" href="#join" data-tab-link="join" data-testid="hero-join"><Icon Name="log-in" /><span class="btn-label">Join a session</span></a>
            </div>
            <ul class="hero-facts">
                <li><Icon Name="check" /> No account or install</li>
                <li><Icon Name="check" /> Optional PIN</li>
                <li><Icon Name="check" /> Ends after 15 minutes to 24 hours</li>
            </ul>
        </div>

        <section class="start-panel" aria-label="Create or join a session" data-tabs>
            <div class="tabs" role="tablist" aria-label="Start">
                <button type="button" role="tab" class="tab" id="tab-create" aria-controls="create" aria-selected="true" data-tab="create">Create a session</button>
                <button type="button" role="tab" class="tab" id="tab-join" aria-controls="join" aria-selected="false" tabindex="-1" data-tab="join">Join a session</button>
            </div>
            <div class="tab-panel" role="tabpanel" id="create" aria-labelledby="tab-create" tabindex="-1">
                <CreateSessionCard @rendermode="InteractiveServer" />
            </div>
            <div class="tab-panel" role="tabpanel" id="join" aria-labelledby="tab-join" tabindex="-1" hidden>
                <p class="tab-intro">Enter the session ID shown on the other device. You can also scan its QR code or open its link.</p>
                <JoinForm @rendermode="InteractiveServer" />
            </div>
        </section>
    </section>

    <section class="section how" aria-labelledby="how-title">
        <h2 id="how-title" class="section-title">How it works</h2>
        <ol class="steps">
            <li class="step">
                <h3 class="step-title">Create a session</h3>
                <p>You get a session ID, a link and a QR code. Choose how long the session lasts, and add a PIN if the text is sensitive.</p>
            </li>
            <li class="step">
                <h3 class="step-title">Join from another screen</h3>
                <p>On the other device, enter the session ID or scan the QR code. A laptop, a shared computer, a tablet or a phone all work.</p>
            </li>
            <li class="step">
                <h3 class="step-title">Type, paste, copy</h3>
                <p>Changes appear on every device right away. Copy or download the result, and start an audio or video call if you need to talk.</p>
            </li>
        </ol>
    </section>

    <section class="section privacy" aria-labelledby="privacy-title">
        <div class="privacy-intro">
            <h2 id="privacy-title" class="section-title">What happens to your text</h2>
            <p>NeuralBridge is built for moving text, not keeping it. <a href="/security">Read the security details</a>.</p>
        </div>
        <dl class="facts">
            <div class="fact">
                <dt><Icon Name="clock" /> Kept in memory only</dt>
                <dd>Shared text is never written to the database or to logs. It's deleted when the session is closed or expires.</dd>
            </div>
            <div class="fact">
                <dt><Icon Name="lock" /> The session ID is the key</dt>
                <dd>Anyone with the ID can join a session without a PIN while it runs. Add a PIN when the text matters.</dd>
            </div>
            <div class="fact">
                <dt><Icon Name="video" /> Calls go device to device</dt>
                <dd>Audio and video travel directly between browsers. The camera and microphone only switch on when you join a call.</dd>
            </div>
            <div class="fact">
                <dt><Icon Name="shield-check" /> Nothing in the background</dt>
                <dd>NeuralBridge never reads your clipboard, screen or keystrokes outside its editor. Copying only happens when you click Copy.</dd>
            </div>
        </dl>
    </section>

    @if (Providers.AccountsAvailable)
    {
        <section class="section accounts" aria-labelledby="accounts-title">
            <AuthorizeView>
                <Authorized>
                    <div class="accounts-text">
                        <h2 id="accounts-title" class="section-title">Welcome back, @context.User.DisplayName()</h2>
                        <p>Sessions you create while signed in are listed in My sessions, where you can reopen or close them from any device.</p>
                    </div>
                    <div class="accounts-actions">
                        <a class="btn btn-secondary" href="/account/sessions"><Icon Name="history" /><span class="btn-label">My sessions</span></a>
                        <a class="btn btn-quiet" href="/account/saved"><Icon Name="bookmark" /><span class="btn-label">Saved text</span></a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="accounts-text">
                        <h2 id="accounts-title" class="section-title">Accounts are optional</h2>
                        <p>Everything above works without one. With an account you can see your sessions in one place, close them from any device, and save text you want to keep.</p>
                    </div>
                    <div class="accounts-actions">
                        @if (Providers.GoogleAvailable)
                        {
                            <GoogleButton ReturnUrl="/" />
                        }
                        @if (Providers.LocalAccountsAvailable)
                        {
                            <a class="btn btn-quiet" href="/account/register">Create an account</a>
                        }
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </section>
    }
</div>
