@page "/not-found"

<PageTitle>Page not found · NeuralBridge</PageTitle>

<div class="page-narrow">
    <EmptyState Title="There's nothing at this address">
        <ChildContent><p>If you followed a session link, the session may have ended. Ask for a new code.</p></ChildContent>
        <Actions>
            <a class="btn btn-primary" href="/">Go to NeuralBridge</a>
            <a class="btn btn-quiet" href="/join">Enter a code</a>
        </Actions>
    </EmptyState>
</div>
