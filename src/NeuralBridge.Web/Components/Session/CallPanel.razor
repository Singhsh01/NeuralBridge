@using NeuralBridge.Application.Calls
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ICallService Calls
@inject ToastService Toasts
@inject ILogger<CallPanel> Logger

<section class="call @(_inCall ? "is-active" : null) @(OthersInCall && !_inCall ? "is-incoming" : null)" aria-labelledby="call-title" data-testid="call-panel">
    <div class="call-bar">
        <div class="call-bar-text">
            <h2 id="call-title" class="call-title">
                <Icon Name="@(_inCall ? "radio" : OthersInCall ? "phone-incoming" : "phone")" />
                @if (_inCall)
                {
                    <span>In call · @_roster.Count @(_roster.Count == 1 ? "person" : "people")</span>
                }
                else if (OthersInCall)
                {
                    <span>@CallerSummary</span>
                }
                else
                {
                    <span>Talk while you share</span>
                }
            </h2>
            @if (!_inCall && !OthersInCall)
            {
                <p class="call-hint">Start an audio or video call with everyone in this session. Media goes directly between devices.</p>
            }
        </div>

        <div class="call-controls" role="group" aria-label="Call controls">
            @if (!_inCall)
            {
                <button type="button" class="btn btn-call @(OthersInCall ? "is-ringing" : null)" disabled="@_busy" @onclick="() => JoinAsync(false)"
                        data-tip="@(OthersInCall ? "Join the call with your microphone" : "Start an audio call")" data-testid="call-audio">
                    <Icon Name="phone" /><span class="btn-label">@(OthersInCall ? "Join with audio" : "Audio call")</span>
                </button>
                <button type="button" class="btn btn-quiet" disabled="@_busy" @onclick="() => JoinAsync(true)"
                        data-tip="@(OthersInCall ? "Join the call with camera and microphone" : "Start a video call")" data-testid="call-video">
                    <Icon Name="video" /><span class="btn-label">@(OthersInCall ? "Join with video" : "Video call")</span>
                </button>
            }
            else
            {
                <button type="button" class="icon-btn @(_micOn ? "is-on" : "is-muted")" data-mic-level aria-pressed="@(_micOn ? "true" : "false")"
                        aria-label="@(_micOn ? "Mute microphone" : "Unmute microphone")" data-tip="@(_micOn ? "Mute microphone" : "Unmute microphone")"
                        @onclick="ToggleMicAsync" disabled="@_busy" data-testid="call-mic">
                    <Icon Name="@(_micOn ? "mic" : "mic-off")" />
                </button>
                <button type="button" class="icon-btn @(_camOn ? "is-on is-video" : null)" aria-pressed="@(_camOn ? "true" : "false")"
                        aria-label="@(_camOn ? "Turn camera off" : "Turn camera on")" data-tip="@(_camOn ? "Turn camera off" : "Turn camera on")"
                        @onclick="ToggleCameraAsync" disabled="@_busy" data-testid="call-camera">
                    <Icon Name="@(_camOn ? "video" : "video-off")" />
                </button>
                <button type="button" class="btn btn-end" @onclick="LeaveAsync" disabled="@_busy" data-tip="Leave the call (the session keeps running)" data-testid="call-leave">
                    <Icon Name="phone-off" /><span class="btn-label">Leave call</span>
                </button>
            }
        </div>
    </div>

    @* Owned by call.js: Blazor never renders children here. *@
    <div class="call-stage" @ref="_stage" hidden="@(!_inCall)" data-testid="call-stage"></div>
</section>

@code {
    private ElementReference _stage;
    private IJSObjectReference? _module;
    private IJSObjectReference? _call;
    private DotNetObjectReference<CallPanel>? _self;
    private IReadOnlyList<CallRosterEntry> _roster = [];
    private bool _inCall;
    private bool _micOn;
    private bool _camOn;
    private bool _busy;
    private bool _disposed;

    [Parameter, EditorRequired] public ParticipantCredentials Credentials { get; set; } = default!;

    /// <summary>Lets the workspace show who is in the call next to each device.</summary>
    [Parameter] public EventCallback<IReadOnlyList<CallRosterEntry>> OnRosterChanged { get; set; }

    private bool OthersInCall => _roster.Any(r => !r.IsYou);

    private string CallerSummary
    {
        get
        {
            var names = _roster.Where(r => !r.IsYou).Select(r => r.DisplayName).ToList();
            return names.Count switch
            {
                1 => $"{names[0]} is in a call",
                2 => $"{names[0]} and {names[1]} are in a call",
                _ => $"{names[0]} and {names.Count - 1} others are in a call",
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/call.js");
        _call = await _module.InvokeAsync<IJSObjectReference>("createCall", _self, _stage, new
        {
            selfId = Credentials.ParticipantId.ToString(),
            iceServers = Calls.Options.EffectiveIceServers.Select(s => new { urls = s.Urls, username = s.Username, credential = s.Credential }),
        });
        await RefreshRosterAsync();
    }

    /// <summary>Called by the workspace whenever the session's call membership or media state changes.</summary>
    public async Task RefreshRosterAsync()
    {
        var roster = await Calls.GetRosterAsync(Credentials);
        if (!roster.Succeeded || _disposed)
        {
            return;
        }

        _roster = roster.Value!;
        if (_inCall && !_roster.Any(r => r.IsYou))
        {
            // Removed from the call server-side (e.g. the session ended): release devices.
            await HangUpLocallyAsync();
        }

        await SafeJs(c => c.InvokeVoidAsync("onRoster", _roster));
        await OnRosterChanged.InvokeAsync(_roster);
        StateHasChanged();
    }

    /// <summary>Called by the workspace for signaling messages addressed to this participant.</summary>
    public Task DeliverSignalAsync(Guid from, string payload) =>
        SafeJs(c => c.InvokeVoidAsync("onSignal", from.ToString(), payload));

    [JSInvokable]
    public async Task SendSignal(string to, string payload)
    {
        if (Guid.TryParse(to, out var target))
        {
            await Calls.SignalAsync(Credentials, target, payload);
        }
    }

    /// <summary>Releases camera/microphone (session ended, removed, or leaving the page).</summary>
    public async Task HangUpLocallyAsync()
    {
        _inCall = false;
        _micOn = _camOn = false;
        await SafeJs(c => c.InvokeVoidAsync("leave"));
    }

    private async Task JoinAsync(bool withVideo)
    {
        if (_call is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var media = await _call.InvokeAsync<JoinResult>("join", withVideo);
            if (!media.Ok)
            {
                Toasts.Error(media.Error ?? "Couldn't start the call.");
                return;
            }

            var joined = await Calls.JoinAsync(Credentials, media.Audio, media.Video);
            if (!joined.Succeeded)
            {
                await _call.InvokeVoidAsync("leave");
                Toasts.Error(joined.Message ?? ErrorMessages.For(joined.Error));
                return;
            }

            _inCall = true;
            _micOn = media.Audio;
            _camOn = media.Video;
            if (media.Warning is not null)
            {
                Toasts.Show(media.Warning, ToastKind.Warning);
            }

            await RefreshRosterAsync();
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Joining the call failed in the browser");
            Toasts.Error("Couldn't start the call in this browser.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleMicAsync()
    {
        _micOn = !_micOn;
        await SafeJs(c => c.InvokeVoidAsync("setMic", _micOn));
        await Calls.UpdateMediaAsync(Credentials, _micOn, _camOn);
    }

    private async Task ToggleCameraAsync()
    {
        if (_call is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await _call.InvokeAsync<JoinResult>("setCamera", !_camOn);
            if (!result.Ok)
            {
                Toasts.Error(result.Error ?? "Couldn't switch the camera.");
                return;
            }

            _camOn = !_camOn;
            await Calls.UpdateMediaAsync(Credentials, _micOn, _camOn);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LeaveAsync()
    {
        await HangUpLocallyAsync();
        await Calls.LeaveAsync(Credentials);
    }

    private async Task SafeJs(Func<IJSObjectReference, ValueTask> call)
    {
        if (_call is null)
        {
            return;
        }

        try
        {
            await call(_call);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Call interop failed");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_inCall)
        {
            await Calls.LeaveAsync(Credentials);
        }

        await SafeJs(c => c.InvokeVoidAsync("dispose"));
        try
        {
            if (_call is not null)
            {
                await _call.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }

    private sealed record JoinResult(bool Ok, bool Audio, bool Video, string? Error, string? Warning);
}
