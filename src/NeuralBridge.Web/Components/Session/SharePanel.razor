@* How to bring another device in: session ID, link and a QR code of the link.
   The QR code encodes only the public join link (/join/{ID}): never the PIN or a participant token. *@
<details class="panel side-section share-panel @(Prominent ? "is-prominent" : null)" open data-collapse-mobile="@(Prominent ? null : "")" data-testid="share-panel">
    <summary class="side-summary">
        <span class="panel-title"><Icon Name="share-2" /> @(Prominent ? "Open this on your other device" : "Invite a device")</span>
        <Icon Name="chevron-down" Class="side-chevron" />
    </summary>
    <div class="side-body">
        @if (Prominent)
        {
            <p class="panel-lede">On the other device, scan the QR code, open the link, or enter the session ID.</p>
        }

        <div class="share-row">
            <span class="share-label" id="share-id-label">Session ID</span>
            <div class="share-code" aria-labelledby="share-id-label">
                <span class="share-code-value" data-testid="session-code">@Code</span>
                <CopyButton Text="@Code" Label="Copy" CopiedLabel="Copied" Class="btn-secondary btn-xs" AriaLabel="Copy session ID" Tip="Copy the session ID" />
            </div>
        </div>

        <div class="share-row">
            <label class="share-label" for="share-url">Join link</label>
            <div class="input-row">
                <input id="share-url" class="input input-mono input-sm" readonly value="@ShareUrl" data-select-on-focus />
                <CopyButton TargetSelector="#share-url" Label="Copy" CopiedLabel="Copied" Class="btn-secondary btn-sm" AriaLabel="Copy join link" Tip="Copy the join link (L)" />
            </div>
        </div>

        <details class="qr" data-qr="@ShareUrl" open="@Prominent" data-testid="qr-toggle">
            <summary class="btn btn-quiet btn-sm qr-summary"><Icon Name="qr-code" /><span class="btn-label">QR code</span></summary>
            <div class="qr-box">
                <div class="qr-target" role="img" aria-label="QR code for the join link" data-testid="qr-code"></div>
                <p class="hint">Scan with the other device's camera to open the join link. @(HasPin ? "The PIN isn't in the code; enter it on the other device." : null)</p>
            </div>
        </details>

        @if (!HasPin)
        {
            <p class="notice notice-warn">
                <Icon Name="lock-open" />
                <span>
                    Anyone with this session ID can join while the session runs.
                    @if (IsOwner)
                    {
                        <span>Add a PIN under Owner controls if the text is sensitive.</span>
                    }
                </span>
            </p>
        }
        else
        {
            <p class="notice"><Icon Name="lock" /><span>A PIN is required to join. Share it separately from the session ID.</span></p>
        }
    </div>
</details>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string ShareUrl { get; set; } = string.Empty;

    [Parameter] public bool HasPin { get; set; }

    [Parameter] public bool IsOwner { get; set; }

    [Parameter] public bool Prominent { get; set; }
}
