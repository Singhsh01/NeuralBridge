<div class="empty-state @Class" role="@(IsAlert ? "alert" : null)">
    @if (IconName is not null)
    {
        <div class="empty-icon" aria-hidden="true"><Icon Name="@IconName" /></div>
    }
    <h2 class="empty-title">@Title</h2>
    @if (ChildContent is not null)
    {
        <div class="empty-body">@ChildContent</div>
    }
    @if (Actions is not null)
    {
        <div class="empty-actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? IconName { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public bool IsAlert { get; set; }
}
