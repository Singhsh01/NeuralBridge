@* Two devices joined by a bridge: two nodes and an arc. Drawn in the accent colour. *@
<span class="logo @Class" aria-label="@(ShowWordmark ? null : "NeuralBridge")" role="@(ShowWordmark ? null : "img")">
    <svg class="logo-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect x="0.5" y="0.5" width="23" height="23" rx="6" fill="var(--accent)" />
        <path d="M6.5 15.5 C 8.5 8, 15.5 8, 17.5 15.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" />
        <circle cx="6.5" cy="16" r="2" fill="#fff" />
        <circle cx="17.5" cy="16" r="2" fill="#fff" />
    </svg>
    @if (ShowWordmark)
    {
        <span class="logo-word">NeuralBridge</span>
    }
</span>

@code {
    [Parameter] public bool ShowWordmark { get; set; } = true;

    [Parameter] public string? Class { get; set; }
}
